# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: catalog writes and account deletion
SUPABASE_SECRET_KEY=

# Spotify (developer.spotify.com, Client Credentials) - songs catalog
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# setlist.fm (api.setlist.fm) - setlist import; non-commercial use only
SETLISTFM_API_KEY=

# GeoNames username (geonames.org) - city suggestions
GEONAMES_USERNAME=

# Optional: contact address shown on the privacy page
CONTACT_EMAIL=
